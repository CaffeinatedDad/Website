{
  // Caffeinated Dad website: static assets only, no Worker script.
  // Routes and domains are managed in the Cloudflare dashboard, not in this file.
  // workers.dev and preview URLs stay off so the account subdomain is never published.
  "name": "caffeinateddad-website",
  "compatibility_date": "2026-10-18",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
